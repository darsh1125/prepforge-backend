# Server
PORT=5000
NODE_ENV=development

# MongoDB — never commit real credentials
MONGODB_URI=

# Session cookie signing (used in later auth work)
SESSION_SECRET=

# Allowed frontend origin for CORS (no wildcards)
WEB_ORIGIN=http://localhost:3000

# LLM provider — optional until generation is implemented
# Application tests must not require this value.
LLM_API_KEY=

# Future / documented
# LLM_MODEL=
# LLM_BASE_URL=
# EVALUATION_FETCH_MODE=  # never a global "disable SSRF" flag; evaluator uses a narrow mode
