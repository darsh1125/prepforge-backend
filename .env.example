# Server
PORT=5000
NODE_ENV=development

# MongoDB — never commit real credentials
MONGODB_URI=

# Session cookie signing
SESSION_SECRET=
AUTH_COOKIE_NAME=pf_session
AUTH_TOKEN_TTL_SECONDS=604800
BCRYPT_ROUNDS=10
RETRIEVAL_TIMEOUT_MS=10000
RETRIEVAL_MAX_BYTES=4194304
RETRIEVAL_MAX_PAGES=7
RETRIEVAL_MAX_REDIRECTS=4
SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search
SEARCH_API_KEY=

# Allowed frontend origin for CORS (no wildcards)
WEB_ORIGIN=http://localhost:3000

# LLM provider — optional until generation is implemented
# Application tests must not require this value.
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1

# The evaluator uses a narrow internal localhost mode; there is no global
# environment switch that disables production SSRF protection.
