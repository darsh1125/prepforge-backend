# Server
PORT=5000
NODE_ENV=development

# MongoDB — never commit real credentials
MONGODB_URI=

# Session cookie signing
SESSION_SECRET=
AUTH_COOKIE_NAME=pf_session
AUTH_TOKEN_TTL_SECONDS=604800
BCRYPT_ROUNDS=10
RETRIEVAL_TIMEOUT_MS=10000
RETRIEVAL_MAX_BYTES=4194304
RETRIEVAL_MAX_PAGES=7
RETRIEVAL_MAX_REDIRECTS=4

# Allowed frontend origin for CORS (no wildcards)
WEB_ORIGIN=http://localhost:3000

# LLM provider — optional until generation is implemented
# Application tests must not require this value.
LLM_API_KEY=

# Future / documented
# LLM_MODEL=
# LLM_BASE_URL=
# EVALUATION_FETCH_MODE=  # never a global "disable SSRF" flag; evaluator uses a narrow mode
